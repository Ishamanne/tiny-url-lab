{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "URL Shortener API",
    "description" : "API for creating and managing shortened URLs with caching and metrics support.\n\nFeatures:\n- Create, retrieve, and delete shortened URLs\n- Analytics tracking for URL clicks\n- Caching for improved performance\n- Metrics monitoring via /actuator/metrics\n- Prometheus metrics at /actuator/prometheus\n\nAuthentication:\n- USER role: Can view URLs and analytics\n- ADMIN role: Can create and delete URLs\n",
    "contact" : {
      "name" : "API Support",
      "email" : "support@example.com"
    },
    "license" : {
      "name" : "Apache 2.0",
      "url" : "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version" : "2.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "basicAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "URL Shortener",
    "description" : "URL shortening and management API"
  } ],
  "paths" : {
    "/api/shorten" : {
      "post" : {
        "tags" : [ "URL Shortener" ],
        "summary" : "Create a short URL",
        "description" : "Creates a shortened URL from an original URL. Requires ADMIN role. This operation invalidates the URL caches and tracks latency metrics.",
        "operationId" : "createShortUrl",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateShortUrlRequest"
              },
              "example" : {
                "originalUrl" : "https://example.com"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Short URL created successfully",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid request - check validation errors",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Forbidden - requires ADMIN role",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ]
      }
    },
    "/api/urls/{shortCode}" : {
      "get" : {
        "tags" : [ "URL Shortener" ],
        "summary" : "Get a specific short URL",
        "description" : "Retrieves details of a shortened URL by its short code with caching enabled. Requires USER or ADMIN role.",
        "operationId" : "getShortUrl",
        "parameters" : [ {
          "name" : "shortCode",
          "in" : "path",
          "description" : "Short code of the URL",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Short URL details",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Short URL not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ]
      },
      "patch" : {
        "tags" : [ "URL Shortener" ],
        "summary" : "Update a short URL",
        "description" : "Updates a shortened URL's expiration time. Requires ADMIN role.",
        "operationId" : "updateShortUrl",
        "parameters" : [ {
          "name" : "shortCode",
          "in" : "path",
          "description" : "Short code of the URL",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateShortUrlRequest"
              },
              "example" : {
                "expiresInMinutes" : 60
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Short URL updated successfully",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Forbidden - requires ADMIN role",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Short URL not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShortUrlResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ]
      }
    },
    "/api/urls" : {
      "get" : {
        "tags" : [ "URL Shortener" ],
        "summary" : "Get all short URLs",
        "description" : "Retrieves a list of all shortened URLs with caching enabled for improved performance. Requires USER or ADMIN role.",
        "operationId" : "getAllShortUrls",
        "responses" : {
          "200" : {
            "description" : "List of all short URLs",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ShortUrlResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ShortUrlResponse"
                  }
                }
              }
            }
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ]
      },
      "delete" : {
        "tags" : [ "URL Shortener" ],
        "summary" : "Delete a short URL",
        "description" : "Marks a shortened URL as expired/deleted. Requires ADMIN role.",
        "operationId" : "deleteShortUrl",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DeleteShortUrlRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Short URL deleted successfully"
          },
          "403" : {
            "description" : "Forbidden - requires ADMIN role"
          },
          "400" : {
            "description" : "Invalid request"
          },
          "401" : {
            "description" : "Unauthorized"
          },
          "404" : {
            "description" : "Short URL not found"
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ]
      }
    },
    "/api/urls/{shortCode}/analytics" : {
      "get" : {
        "tags" : [ "URL Shortener" ],
        "summary" : "Get analytics for a short URL",
        "description" : "Retrieves click analytics for a shortened URL including total clicks and click history with caching enabled. Requires USER or ADMIN role.",
        "operationId" : "getAnalytics",
        "parameters" : [ {
          "name" : "shortCode",
          "in" : "path",
          "description" : "Short code of the URL",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Analytics data",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Unauthorized",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Short URL not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalyticsResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "basicAuth" : [ ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateShortUrlRequest" : {
        "required" : [ "originalUrl" ],
        "type" : "object",
        "properties" : {
          "originalUrl" : {
            "pattern" : "^https?://.*",
            "type" : "string",
            "description" : "The original URL to shorten",
            "example" : "https://example.com"
          },
          "customAlias" : {
            "type" : "string",
            "description" : "Optional custom alias for the short URL (leave empty for auto-generated)",
            "nullable" : true
          },
          "expiresInMinutes" : {
            "type" : "integer",
            "description" : "Optional expiration time in minutes (default: 7 minutes if not specified)",
            "format" : "int64",
            "nullable" : true
          }
        },
        "description" : "Request to create a shortened URL"
      },
      "ShortUrlResponse" : {
        "type" : "object",
        "properties" : {
          "shortCode" : {
            "type" : "string"
          },
          "shortUrl" : {
            "type" : "string"
          },
          "originalUrl" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "clickCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "EXPIRED" ]
          }
        }
      },
      "UpdateShortUrlRequest" : {
        "type" : "object",
        "properties" : {
          "expiresInMinutes" : {
            "type" : "integer",
            "description" : "New expiration time in minutes from now",
            "format" : "int64",
            "nullable" : true
          }
        },
        "description" : "Request to update a shortened URL"
      },
      "AnalyticsResponse" : {
        "type" : "object",
        "properties" : {
          "shortCode" : {
            "type" : "string",
            "description" : "Short code of the URL"
          },
          "totalClicks" : {
            "type" : "integer",
            "description" : "Total number of clicks since URL creation (resets on app restart)",
            "format" : "int64"
          },
          "deviceDistribution" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "description" : "Distribution of clicks by device type (mobile/desktop)",
              "format" : "int64"
            },
            "description" : "Distribution of clicks by device type (mobile/desktop)"
          }
        },
        "description" : "Analytics data for a shortened URL (Note: Data is volatile - stored in H2 in-memory database)"
      },
      "DeleteShortUrlRequest" : {
        "required" : [ "shortCode" ],
        "type" : "object",
        "properties" : {
          "shortCode" : {
            "type" : "string",
            "description" : "The short code to delete"
          }
        },
        "description" : "Request to delete a shortened URL"
      }
    },
    "securitySchemes" : {
      "basicAuth" : {
        "type" : "http",
        "description" : "Basic Authentication - Use 'user:user123' or 'admin:admin123'",
        "name" : "basicAuth",
        "scheme" : "basic"
      }
    }
  }
}